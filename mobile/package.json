{
  "name": "magizhchi-maillook-mobile",
  "version": "1.0.0",
  "description": "Magizhchi MailLook for Android: the web app in a native shell, with phone alerts, mail links and files",
  "private": true,
  "scripts": {
    "sounds": "node make-sounds.js",
    "www": "node make-www.js",
    "sync": "cap sync android",
    "open": "cap open android",
    "apk": "cd android && gradlew.bat assembleDebug",
    "icons": "node -e \"require('fs').mkdirSync('assets',{recursive:true});require('fs').copyFileSync('../docs/brand/maillook-mark-4k.png','assets/logo.png')\" && capacitor-assets generate --android --iconBackgroundColor #fbf8f2 --iconBackgroundColorDark #0e1a1d --splashBackgroundColor #fbf8f2 --splashBackgroundColorDark #0e1a1d --logoSplashScale 0.25"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.4",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/push-notifications": "^6.0.4",
    "@capacitor/share": "^6.0.3",
    "@capacitor-community/file-opener": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@capacitor/assets": "^3.0.5"
  }
}
