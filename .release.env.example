# The Hostinger FTP login for scripts/release.mjs. No secrets in this file.
#
# Put the real values in C:\Users\<you>\.magizhchi\hostinger-ftp.env — one file shared by every Magizhchi app,
# outside every git repo — never in this repo. Environment variables of the same name win over that file.
# hPanel -> Files -> FTP Accounts has the user name; the password is the one set there.

HOSTINGER_FTP_USER=
HOSTINGER_FTP_PASSWORD=

# Optional. The defaults are in scripts/release.mjs:
# HOSTINGER_FTP_HOST=145.79.28.196            (ftp.magizhchi.software doesn't exist)
# HOSTINGER_FTP_DIR=/public_html/maillook/    the folder maillook.magizhchi.software serves; never /public_html itself
