# Used by `npm run build` for the Hostinger upload (maillook.magizhchi.software).
# The API runs on Railway behind this custom domain; its CORS_ORIGINS must list the site above.
VITE_API_URL=https://maillookback.magizhchi.software
# Magizhchi ID's hosted sign-in page.
VITE_ID_LOGIN_URL=https://accounts.magizhchi.software

# Magizhchi Viewer: attachments open in it when this is set and the site is reachable;
# otherwise the Open button behaves as it did before (a new tab).
VITE_VIEWER_URL=https://viewer.magizhchi.software
